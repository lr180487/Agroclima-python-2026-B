# ═══════════════════════════════════════════════════
# AgroClima Backend · variables de entorno
# Copia a .env (o exporta en el entorno) y ajusta.
# ═══════════════════════════════════════════════════

# Secreto para firmar JWT — genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MIN=480

# Base de datos.
# Por defecto (sin definir): SQLite en backend/agroclima.db
# PostgreSQL real (requiere: pip install psycopg2-binary y correr schema_postgres.sql):
# DATABASE_URL=postgresql+psycopg2://agroclima:secret@localhost:5432/agroclima

# OAuth 2.0 de Google (opcional — sin esto, /api/auth/google responde 501).
# 1. console.cloud.google.com → crear proyecto → OAuth consent screen
# 2. Credenciales → OAuth Client ID (tipo Web) → agregar el origen del frontend
# 3. Pegar aquí el Client ID:
# GOOGLE_CLIENT_ID=123456789-xxxxxxxx.apps.googleusercontent.com
