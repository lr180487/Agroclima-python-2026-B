# ═══════════════════════════════════════════════════════════════
# AgroClima Backend · .env de PRODUCCIÓN
#
# USO:  cp .env.production .env   (el backend lo carga solo)
#
# ⚠️ SEGURIDAD:
#   - NUNCA subas este archivo a git  →  añade ".env*" a .gitignore
#   - Los secretos de abajo fueron generados con openssl rand;
#     si el archivo se filtra, regenera TODOS con: openssl rand -hex 32
#   - Las variables del entorno real del servidor tienen prioridad
#     sobre este archivo (puedes inyectarlas por systemd/Docker/CI)
# ═══════════════════════════════════════════════════════════════

# ─────────────── Entorno ───────────────
# production → oculta /docs y /redoc, desactiva el seed de usuarios demo
APP_ENV=production

# Poner en true SOLO temporalmente si necesitas Swagger en producción
DOCS_ENABLED=false

# No crear cuentas demo (admin@agroclima.pe, etc.) en producción
SEED_DEMO_USERS=false

# ─────────────── JWT (sesiones) ───────────────
# Generado con: openssl rand -hex 32  → regenerar al desplegar
JWT_SECRET=07f33419d423a2c9b4271afb83c74d85b8df6a2101152d1c81c10072e6b03318

# Expiración del token en minutos (480 = 8 horas laborales)
JWT_EXPIRE_MIN=480

# ─────────────── Base de datos ───────────────
# PRODUCCIÓN: PostgreSQL (requiere: pip install psycopg2-binary
#             y haber corrido schema_postgres.sql)
# Ajusta host/usuario/base según tu infraestructura (RDS, Cloud SQL, VPS…)
DATABASE_URL=postgresql+psycopg2://agroclima:Do4pNVbZMkHOTASqZ2VVeczv@db.tudominio.com:5432/agroclima

# Alternativa mientras migras (comenta la línea de arriba):
# DATABASE_URL=sqlite:////var/lib/agroclima/agroclima.db

# ─────────────── CORS ───────────────
# Lista separada por comas de orígenes permitidos del frontend.
# NUNCA dejes "*" en producción.
CORS_ORIGINS=https://agroclima.pe,https://www.agroclima.pe

# ─────────────── OAuth 2.0 de Google ───────────────
# console.cloud.google.com → APIs y servicios → Credenciales
#   1. OAuth consent screen: tipo Externo, dominio agroclima.pe
#   2. Client ID OAuth (tipo Web):
#      - Orígenes JS autorizados:  https://agroclima.pe
#      - (El flujo usa id_token de Google Identity Services; no requiere redirect URI)
#   3. Pega el Client ID aquí (el frontend usa el mismo valor):
GOOGLE_CLIENT_ID=REEMPLAZAR-123456789-xxxxxxxxxxxx.apps.googleusercontent.com

# ═══════════════════════════════════════════════════════════════
# Variables usadas por el backend GAS (Script Properties, NO en
# este archivo — se configuran en script.google.com → Settings):
#   SECRET            = fd98141440bcbd37f0c3c6a1e1ea357af10ca0b4560d22f8d6aae9f8b5e3ad91
#   GOOGLE_CLIENT_ID  = (el mismo de arriba)
#   PG_URL            = jdbc:postgresql://db.tudominio.com:5432/agroclima
#   PG_USER           = agroclima
#   PG_PASS           = (la misma contraseña de DATABASE_URL)
# ═══════════════════════════════════════════════════════════════

# ─────────────── Checklist de despliegue ───────────────
# [ ] Regenerar JWT_SECRET y contraseña de PostgreSQL
# [ ] Crear la BD:  createdb agroclima && psql -d agroclima -f schema_postgres.sql
# [ ] pip install -r requirements.txt psycopg2-binary
# [ ] Crear el primer admin real:
#       curl -X POST https://api.agroclima.pe/api/auth/register \
#         -H "Content-Type: application/json" \
#         -d '{"email":"tu@agroclima.pe","name":"Tu Nombre","password":"...","role":"admin"}'
#     (luego puedes desactivar el registro público si lo deseas)
# [ ] Servir detrás de HTTPS (nginx/caddy) — JWT viaja en el header
# [ ] Ejecutar con:  uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4
